#include <windows.h>
#include "../build/obj/version.h"
1 ICON "../build/release/BingWallpaperLite.ico"
1 RT_MANIFEST "../src/App.manifest"
1 VERSIONINFO
 FILEVERSION APP_VERSION_TUPLE
 PRODUCTVERSION APP_VERSION_TUPLE
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Bing Wallpaper Lite\0"
   VALUE "FileDescription", "Bing Wallpaper Lite - native tray utility\0"
   VALUE "InternalName", "BingWallpaperLite\0"
   VALUE "OriginalFilename", "BingWallpaperLite.exe\0"
   VALUE "FileVersion", APP_VERSION_STRING
   VALUE "ProductName", "Bing Wallpaper Lite\0"
   VALUE "ProductVersion", APP_VERSION_STRING
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
